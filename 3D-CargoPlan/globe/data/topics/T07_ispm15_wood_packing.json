    {
      "term": "ISPM 15",
      "zh": "国际植检措施标准第15号",
      "def": "IPPC standard for wood packaging material in international trade — debarked wood + approved treatment + mark."
    },
    {
      "term": "WPM",
      "zh": "木质包装材料",
      "def": "Pallets, crates, dunnage of raw wood; excludes processed wood like plywood (generally)."
    },
    {
      "term": "Mark",
      "zh": "IPPC 标识",
      "def": "Symbol + ISO country + producer code + treatment code (HT/DH/MB/SF); legible, durable, not hand-drawn."
    }
  ],
  "who_pays": {
