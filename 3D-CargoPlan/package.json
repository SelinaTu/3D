{
  "name": "cargoplan",
  "version": "1.1.0",
  "description": "AI-powered 3D container packing optimization system",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "npm run typecheck && vite build && npm run build:globe && node scripts/build-server.mjs",
    "start": "node dist-server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "parse": "tsx src/scripts/parse-data.ts",
    "optimize": "tsx src/scripts/optimize.ts",
    "test": "vitest run --exclude 'data/**'",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build",
    "acceptance": "tsx src/scripts/acceptance.ts",
    "report:static": "node scripts/build-static-report.mjs",
    "report:calibrated": "node scripts/build-static-report.mjs data/calibration/current-best-research.json output/reports/iraq-villa-calibrated-research.html",
    "calibrate:data": "node scripts/audit-source-baseline.mjs && node --import tsx scripts/audit-support-feasibility.mjs",
    "research:prepare": "node --import tsx src/scripts/research-calibrated.ts",
    "build:globe": "vite build --config vite.globe.config.mjs",
    "desktop:dev": "npm run build && node scripts/run-desktop.mjs",
    "desktop:smoke": "node scripts/run-desktop.mjs --desktop-smoke",
    "desktop:pack": "npm run build && electron-builder --config electron-builder.config.cjs --mac --dir",
    "desktop:dist": "npm run desktop:pack && node scripts/package-mac.mjs",
    "knowledge:server": "python3 scripts/start-knowledge-server.py"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "desktop/main.mjs"
}
